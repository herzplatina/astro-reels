output/
.ruff_cache/
.pytest_cache/
__pycache__/
*.pyc

# OAuth tokens, credentials and personal identifiers — never commit these.
# Ignore the contents rather than the directory: git does not descend into an
# ignored directory, so `!secrets/credentials.example.json` would never match.
secrets/*
!secrets/credentials.example.json
.env
*.token.json
*.local.md

# Music is ~146 MB and fully regenerable: `python3 src/fetch_music.py` rebuilds
# it from CC0 sources. The manifest is tracked so the track list survives.
assets/music/**/*.mp3
!assets/music/manifest.json

.DS_Store

# Quarantined vocal tracks and the metadata lookup cache — both regenerable.
assets/music_quarantine/
assets/music/.metadata_cache.json

# Local checkout of the gh-pages hosting branch.
.hosting/
